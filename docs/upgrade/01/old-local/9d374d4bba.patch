    fix(whatsapp): tolerate a LID device suffix when matching replies to the bot
    
    A reply quotes the bot as "<num>@lid", but the bot id carried in the message can
    include a device index — "<num>@1@lid" — for the same account. The exact-match
    check therefore failed and replies in a group were not recognised as addressed to
    the bot, so the assistant stayed silent unless you @-mentioned it.
    
    Compare the numeric part when the exact match misses.
    
    This was running as an uncommitted edit in the deployed checkout, so any future
    update would have silently reverted it. The debug instrumentation that came with
    it (a console.log on every group message, and a block appending message metadata
    to ~/gw_debug.log) is intentionally NOT included.

diff --git a/gateway/platforms/whatsapp_common.py b/gateway/platforms/whatsapp_common.py
index 09e7b0b64f..b1b83750ac 100644
--- a/gateway/platforms/whatsapp_common.py
+++ b/gateway/platforms/whatsapp_common.py
@@ -346,7 +346,15 @@ class WhatsAppBehaviorMixin:
         quoted_participant = self._normalize_whatsapp_id(data.get("quotedParticipant"))
         if not quoted_participant:
             return False
-        return quoted_participant in self._bot_ids_from_message(data)
+        bot_ids = self._bot_ids_from_message(data)
+        if quoted_participant in bot_ids:
+            return True
+        # LID device-suffix tolerance: a reply quotes "<num>@lid" while the
+        # bot id may carry a device index "<num>@1@lid" (same account).
+        quoted_num = quoted_participant.split("@", 1)[0]
+        return bool(quoted_num) and any(
+            bid.split("@", 1)[0] == quoted_num for bid in bot_ids
+        )
 
     def _message_mentions_bot(self, data: Dict[str, Any]) -> bool:
         bot_ids = self._bot_ids_from_message(data)
