+        "chatId": GROUP_JID,
+        "mentionedIds": [],
+        "botIds": [BOT_JID],
+        "quotedParticipant": "",
+        "hasMedia": False,
+        "mediaUrls": [],
+    }
+    data.update(overrides)
+    return data
