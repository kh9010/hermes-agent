+class _FakeSession:
+    def __init__(self, response, status=200):
+        self.response = response
+        self.status = status
+        self.calls = []
+
+    def post(self, url, **kwargs):
+        self.calls.append((url, kwargs))
+        return _FakeResponse(self.response, status=self.status)
